# --- Telegram (JBN Ops bot, from BotFather) ---
OPS_BOT_TOKEN=
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token on every update
TELEGRAM_WEBHOOK_SECRET=
# Chat IDs of the private groups (negative numbers). Find them with /chatid in the group.
TEAM_GROUP_ID=
DEV_GROUP_ID=

# --- Supabase (bots schema must be listed under API > Exposed schemas) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FILES_BUCKET=bot-files

# --- Vercel cron (Vercel sends Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Dev & Release Monitor ---
# careerGUIDE API base, including /api/v1
MBS_API_BASE=https://careerguide-api.onrender.com/api/v1
MBS_SITE_URL=https://careerguide.vercel.app
# Comma-separated user flows to smoke-test (keys from USER_FLOW_SPECS)
SMOKE_FLOWS=user1,user2,user3,user4,user5,user6
# Dedicated test account (Supabase Auth email/password) used by smoke + seed audit
MBS_SUPABASE_URL=
MBS_SUPABASE_ANON_KEY=
SMOKE_EMAIL=
SMOKE_PASSWORD=

# GitHub: fine-grained token with Issues read/write on the repo below
GITHUB_TOKEN=
GITHUB_REPO=Punyamittal/careerGuide
GITHUB_WEBHOOK_SECRET=
# Vercel: integration/webhook secret for deployment events (team jbn7)
VERCEL_WEBHOOK_SECRET=
# Comma-separated Vercel project names to track (the team webhook covers every project, including this bot).
# Empty = track all projects.
VERCEL_PROJECTS=

# Timezone for all schedules and day boundaries
TZ_NAME=Asia/Kolkata
